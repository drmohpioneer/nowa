MAPBOX_TOKEN=
MAPBOX_TIMEOUT_S=10
DEMO_NO_NETWORK=false

GEMINI_API_KEY=
OPENROUTER_API_KEY=
# Ordered provider:model entries; fixed safe-mode fallback is always appended.
AI_CHAIN=gemini:gemini-3.8-flash,gemini:gemini-3.5-flash,openrouter:anthropic/claude-haiku-4.5
JUDGE_AI_MSG_CAP=200
AI_DAILY_BUDGET_USD=10
AI_CLINIC_DAILY_CEILING=1000

# Health library 
LIBRARY_MIN_SCORE=0.64
# Optional directory override; default is nowa/library/data beside the package.
# LIBRARY_DATA_DIR=/absolute/path/to/library/data
EMBEDDING_USD_PER_CALL=0.00001

JUDGE_CODES=

